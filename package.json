const express = require("express");
const cors = require("cors");
const nodemailer = require("nodemailer");

const app = express();
app.use(cors());
app.use(express.json({ limit: "64kb" }));

const otpStore = new Map();
const rateLimitStore = new Map();

const OTP_TTL_MS = 5 * 60 * 1000;
const RATE_WINDOW_MS = 60 * 1000;
const MAX_REQUESTS_PER_WINDOW = 4;
const MAX_VERIFY_ATTEMPTS = 5;

const mailer = nodemailer.createTransport({
  service: "gmail",
  auth: {
    user: process.env.GMAIL_USER,
    pass: process.env.GMAIL_APP_PASSWORD
  }
});

function isValidGmail(email) {
  const val = String(email || "").trim().toLowerCase();
  if (!/^[a-z0-9._%+-]+@gmail\.com$/.test(val)) return false;
  const localPart = val.split("@")[0];
  return (
    localPart.length >= 3 &&
    !localPart.startsWith(".") &&
    !localPart.endsWith(".") &&
    !localPart.includes("..")
  );
}

function checkRateLimit(key) {
  const now = Date.now();
  const entry = rateLimitStore.get(key) || [];
  const fresh = entry.filter((ts) => now - ts < RATE_WINDOW_MS);
  if (fresh.length >= MAX_REQUESTS_PER_WINDOW) {
    rateLimitStore.set(key, fresh);
    return false;
  }
  fresh.push(now);
  rateLimitStore.set(key, fresh);
  return true;
}

async function sendEmailOtp(email, code, purpose) {
  const labelMap = {
    register: "Account Registration",
    reset_password: "Password Reset",
    reset_cvv: "Card CVV Reset"
  };
  const purposeText = labelMap[purpose] || "Verification";

  await mailer.sendMail({
    from: `"BD Pass" <${process.env.GMAIL_USER}>`,
    to: email,
    subject: `BD Pass ${purposeText} Code`,
    text: `Your 6-digit BD Pass OTP for ${purposeText} is: ${code}\n\nThis code is valid for 5 minutes. Do not share it with anyone.`
  });
}

app.get("/", (req, res) => {
  const mailConfigured = Boolean(process.env.GMAIL_USER && process.env.GMAIL_APP_PASSWORD);
  res.json({
    ok: true,
    service: "BD Pass OTP Server (Gmail)",
    mailConfigured,
    endpoints: ["/send-otp", "/verify-otp"]
  });
});

app.post("/send-otp", async (req, res) => {
  try {
    if (!process.env.GMAIL_USER || !process.env.GMAIL_APP_PASSWORD) {
      return res.status(500).json({
        ok: false,
        error: "Server Gmail environment variables are not configured"
      });
    }

    const rawContact = String(req.body.contact || "").trim();
    const purpose = String(req.body.purpose || "verify").trim();

    if (!rawContact) {
      return res.status(400).json({ ok: false, error: "Gmail address required" });
    }

    if (!rawContact.includes("@")) {
      return res.status(400).json({
        ok: false,
        error: "Currently only Gmail OTP is supported"
      });
    }

    const email = rawContact.toLowerCase();
    if (!isValidGmail(email)) {
      return res.status(400).json({
        ok: false,
        error: "Please provide a valid @gmail.com address"
      });
    }

    if (!checkRateLimit(email)) {
      return res.status(429).json({
        ok: false,
        error: "Too many OTP requests. Please wait 1 minute and try again."
      });
    }

    const code = String(Math.floor(100000 + Math.random() * 900000));
    otpStore.set(email, {
      code,
      purpose,
      attempts: 0,
      expiresAt: Date.now() + OTP_TTL_MS
    });

    await sendEmailOtp(email, code, purpose);
    return res.json({ ok: true, message: "OTP sent to Gmail" });
  } catch (err) {
    return res.status(500).json({ ok: false, error: err.message || "Failed to send OTP" });
  }
});

app.post("/verify-otp", (req, res) => {
  try {
    const rawContact = String(req.body.contact || "").trim().toLowerCase();
    const code = String(req.body.code || "").trim();

    if (!rawContact || !code) {
      return res.status(400).json({ ok: false, error: "Gmail and 6-digit OTP are required" });
    }

    const record = otpStore.get(rawContact);
    if (!record) {
      return res.status(400).json({ ok: false, error: "No active OTP found. Please request a new OTP." });
    }

    if (Date.now() > record.expiresAt) {
      otpStore.delete(rawContact);
      return res.status(400).json({ ok: false, error: "OTP expired. Please request a new OTP." });
    }

    if (record.attempts >= MAX_VERIFY_ATTEMPTS) {
      otpStore.delete(rawContact);
      return res.status(429).json({ ok: false, error: "Too many wrong attempts. Request a new OTP." });
    }

    if (record.code !== code) {
      record.attempts += 1;
      otpStore.set(rawContact, record);
      return res.status(400).json({ ok: false, error: "Invalid OTP code" });
    }

    otpStore.delete(rawContact);
    return res.json({ ok: true, verified: true, message: "OTP verified successfully" });
  } catch (err) {
    return res.status(500).json({ ok: false, error: err.message || "OTP verification failed" });
  }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log(`BD Pass OTP server running on port ${PORT}`);
});
